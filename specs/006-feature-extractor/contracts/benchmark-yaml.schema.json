{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnessbuddy.local/schemas/benchmark-yaml.schema.json",
  "title": "BenchmarkYaml",
  "description": "Structure of the YAML file produced by `harnessbuddy generate-benchmark` (FR-011), matching oss-fuzz-gen's Benchmark.to_yaml/from_yaml shape (experiment/benchmark.py). Validated as a JSON Schema against the structure obtained by yaml.safe_load(); the file on disk is YAML, not JSON.",
  "type": "object",
  "required": ["project", "language", "target_path", "target_name", "functions"],
  "additionalProperties": false,
  "properties": {
    "project": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "enum": ["c", "cpp"] },
    "target_name": { "type": "string", "minLength": 1, "default": "default_fuzzer" },
    "target_path": { "type": "string", "minLength": 1, "description": "Defaults to /src/harness_source/default_fuzzer.{c,cc}; user-overridable, so no fixed pattern is enforced here." },
    "functions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "signature", "return_type", "params"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "signature": { "type": "string", "minLength": 1 },
          "return_type": { "type": "string" },
          "params": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
